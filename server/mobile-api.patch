+                    'name' => $row['title'],
+                    'slug' => $row['slug'],
+                    'intro' => $row['summary'],
+                    'cover_image' => $row['featured_image'],
+                ]);
+                continue;
+            }
+            // post
+            $items[] = jhd_api_post_item([
+                'id' => $row['id'],
+                'title' => $row['title'],
+                'slug' => $row['slug'],
+                'summary' => $row['summary'],
+                'content' => $row['content'],
+                'featured_image' => $row['featured_image'],
+                'post_type' => $row['post_type'],
