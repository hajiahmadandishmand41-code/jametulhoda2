+
+    // ─── رسانه (صوت/ویدیو) ──────────────────────────────────────────
+    case 'media':
+        jhd_api_method(['GET', 'HEAD']);
+        $viewer = jhd_api_user();
+        $kind = (string)($_GET['kind'] ?? 'all');
+        if (!in_array($kind, ['all', 'audio', 'video'], true)) {
